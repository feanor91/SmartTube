{
  "name": "smarttube-desktop",
  "version": "0.2.1",
  "description": "SmartTube pour Windows : client YouTube TV sans publicité avec SponsorBlock",
  "main": "main.js",
  "author": "SmartTube Desktop",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win zip --x64"
  },
  "build": {
    "appId": "app.smarttube.desktop",
    "productName": "SmartTube",
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "SmartTube-${version}-win.${ext}",
      "icon": "icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}